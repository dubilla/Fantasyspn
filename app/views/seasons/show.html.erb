<% if @season %>
  <section class="season">
    <h2 class="season-name"><%= @season.name %></h2>
    <% if @posts.present? %>
      <ul>
        <% @posts.each do |post| %>
          <li>
            <%= link_to post.title, post %>
            <span class="post-published-wrapper">| <span class="post-published"><%= post.published_at.strftime("%B %d, %Y") %></span></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="season-empty">No posts yet this season.</p>
    <% end %>
    <nav class="season-nav">
      <% if (previous_season = @season.previous) %>
        <%= link_to "← #{previous_season.name}", previous_season, class: "season-nav-previous" %>
      <% end %>
      <% if (next_season = @season.next) %>
        <%= link_to "#{next_season.name} →", next_season, class: "season-nav-next" %>
      <% end %>
    </nav>
  </section>
<% else %>
  <p class="season-empty">No posts yet.</p>
<% end %>
