#!/usr/bin/env bash
set -uo pipefail
cd "$(dirname "$0")/.."

if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

port="${PORT:-3000}"
if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "Port $port is already in use (another bin/dev?). Set PORT to use a different one." >&2
  exit 1
fi

mkdir -p logs
exec > >(tee -i logs/dev.log) 2>&1

PORT="$port" bin/rails server -p "$port" > >(sed -u 's/^/[web]    /') 2>&1 &
web=$!
bundle exec sidekiq -C config/sidekiq.yml > >(sed -u 's/^/[worker] /') 2>&1 &
worker=$!

stop() {
  trap - INT TERM EXIT
  kill "$web" "$worker" 2>/dev/null
  wait "$web" "$worker" 2>/dev/null
}
trap 'stop; exit 130' INT
trap 'stop; exit 143' TERM
trap stop EXIT

while kill -0 "$web" 2>/dev/null && kill -0 "$worker" 2>/dev/null; do
  sleep 1
done

echo "A dev process exited; shutting down the rest." >&2
exit 1
